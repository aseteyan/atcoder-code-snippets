	"TopologicalSort": {
		"prefix": "TopologicalSort",
		"body": [
			"std::vector<int> TopologicalSort(const std::vector<std::vector<int>>& graph){",
			"    std::vector<int> indegrees(graph.size());",
			"    for(const auto& v : graph)for(const auto& to : v)++indegrees[to];",
			"",
			"    std::priority_queue<int, std::vector<int>, std::greater<>> q;",
			"    for(int i=0; i<static_cast<int>(graph.size()); ++i)if(indegrees[i]==0)q.push(i);",
			"",
			"    std::vector<int> result;",
			"",
			"    while(!q.empty()){",
			"        const int from=q.top(); q.pop();",
			"        result.push_back(from);",
			"        for(const auto& to : graph[from])if(--indegrees[to]==0)q.push(to);",
			"    }",
			"",
			"    if(result.size()<graph.size())return{};",
			"",
			"    return result;",
			"}",
		],
		"description": "AtCoder template"
	},
	"Combination": {
		"prefix": "Combination",
		"body": [
			"template<typename T>",
			"class combination{",
			"    vector<T> facts, ifacts;",
			"",
			"    void make_table(size_t N){",
			"        if(facts.size()>N)return;",
			"        size_t now=facts.size();",
			"        N=max(N,now*2);",
			"        facts.resize(N+1);",
			"        ifacts.resize(N+1);",
			"        for(size_t i=now;i<=N;i++)facts[i]=facts[i-1]*i;",
			"        ifacts[N]=1/facts[N];",
			"        for(size_t i=N;i-->now;)ifacts[i]=ifacts[i+1]*(i+1);",
			"    }",
			"",
			"public:",
			"    combination(size_t N=0):facts(1,1),ifacts(1,1){",
			"        make_table(N);",
			"    }",
			"",
			"    T fact(size_t n){",
			"        make_table(n);",
			"        return facts[n];",
			"    }",
			"",
			"    T ifact(size_t n){",
			"        make_table(n);",
			"        return ifacts[n];",
			"    }",
			"",
			"    T P(size_t n,size_t k){",
			"        if(n<k)return 0;",
			"        make_table(n);",
			"        return facts[n]*ifacts[n-k];",
			"    }",
			"",
			"    T C(size_t n,size_t k){",
			"        if(n<k)return 0;",
			"        make_table(n);",
			"        return facts[n]*ifacts[n-k]*ifacts[k];",
			"    }",
			"",
			"    T H(size_t n,size_t k){",
			"        if(n==0)return k==0?1:0;",
			"        return C(n-1+k,k);",
			"    }",
			"};",
		],
		"description": "AtCoder template"
	},
